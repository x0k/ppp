{
	"name": "ppp",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"paraglide-compile": "paraglide-js compile --strategy url --project ./project.inlang --outdir ./src/lib/paraglide",
		"postinstall": "npm run paraglide-compile",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "oxfmt",
		"lint": "eslint .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"format:check": "oxfmt --check ."
	},
	"dependencies": {
		"@andrewbranch/untar.js": "^1.0.4",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/xterm": "^6.0.0",
		"cpp-runtime": "workspace:*",
		"dotnet-runtime": "workspace:*",
		"esm-env": "^1.2.2",
		"gleam-runtime": "workspace:*",
		"go-runtime": "workspace:*",
		"java-runtime": "workspace:*",
		"javascript-runtime": "workspace:*",
		"libs": "workspace:*",
		"lua-runtime": "workspace:*",
		"marked": "^18.0.10",
		"monaco-editor": "^0.56.0",
		"monaco-editor-textmate": "^4.0.0",
		"monaco-textmate": "^3.0.1",
		"monaco-vim": "^0.4.4",
		"onigasm": "^2.2.5",
		"php-runtime": "workspace:*",
		"python-runtime": "workspace:*",
		"ruby-runtime": "workspace:*",
		"rust-runtime": "workspace:*",
		"typescript-runtime": "workspace:*",
		"zig-runtime": "workspace:*"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@iconify-json/lucide": "^1.2.124",
		"@iconify-json/vscode-icons": "^1.2.74",
		"@inlang/paraglide-js": "^2.24.1",
		"@sveltejs/adapter-static": "4.0.0-next.4",
		"@sveltejs/kit": "3.0.0-next.25",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/color": "^4.2.1",
		"@types/node": "^26.2.0",
		"@vitest/browser-playwright": "^4.1.11",
		"daisyui": "^5.7.20",
		"eslint": "^10.9.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.11.0",
		"oxfmt": "^0.64.0",
		"playwright": "^1.62.1",
		"svelte": "^5.56.10",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.67.0",
		"unplugin-icons": "^23.0.1",
		"vite": "catalog:",
		"vite-plugin-devtools-json": "^1.1.0",
		"vite-plugin-static-copy": "4.1.1",
		"vitest": "catalog:",
		"vitest-browser-svelte": "^3.0.0"
	}
}
